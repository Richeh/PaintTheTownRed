{
  "manifest_version": 3,
  "name": "Town Red for Rightmove",
  "version": "0.2.4",
  "description": "Paint and share collaborative preference areas on Rightmove property maps.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://oikkiayjonjouernvjhw.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.rightmove.co.uk/property-for-sale/map.html*",
        "https://www.rightmove.co.uk/properties/map.html*"
      ],
      "js": ["map-hook.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
